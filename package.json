{
  "name": "codeaudit",
  "version": "0.3.0",
  "description": "Cross-language code purity audit via effect-chain analysis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nuctori/codeaudit.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "codeaudit": "dist/cli.js"
  },
  "files": [
    "dist",
    "scripts",
    "docs"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "test": "node node_modules/vitest/vitest.mjs run",
    "scan:self": "node dist/cli.js scan src",
    "prepare": "node node_modules/typescript/bin/tsc"
  },
  "dependencies": {
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.22.6"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
